  "taskCases": [
    {
      "name": "historical-terminal",
      "profile": "default",
      "durableId": "session",
      "runtime": "replacement",
      "attached": {
        "jsonrpc": "2.0",
        "method": "relay.lease.attached",
        "params": {
          "recovery_version": 1,
          "lease_id": "lease",
          "last_seq": 8,
          "resume_cursor": 0,
          "replay_gap": true,
          "recovery_reset": false,
          "bindings": [],
          "task_snapshot": [
            {
              "jsonrpc": "2.0",
              "method": "event",
              "params": {
                "session_id": "runtime",
                "type": "subagent.complete",
                "payload": {
                  "subagent_id": "child",
                  "status": "completed",
                  "goal": "Synthetic task"
                },
                "recovery_revision": 1,
                "recovery_binding": {
                  "runtime_session_id": "runtime",
                  "durable_session_id": "session",
                  "profile": "default",
                  "live": false
                }
              }
            }
          ]
        }
      },
      "expectedStatus": "Finished",
      "expectedRows": 1,
      "expectedAge": 0,
      "expectedActiveCount": 0
    },
