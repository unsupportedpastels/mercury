{
  "schema_version": 1,
  "cases": [
    {
      "name": "retained-child-and-old-rpc",
      "profile": "default",
      "attached": {
        "jsonrpc": "2.0",
        "method": "relay.lease.attached",
        "params": {
          "recovery_version": 1,
          "lease_id": "lease",
          "last_seq": 2,
          "resume_cursor": 0,
          "replay_gap": false,
          "recovery_reset": false,
          "bindings": [],
          "task_snapshot": []
        }
      },
      "frames": [
        {
          "jsonrpc": "2.0",
          "method": "relay.lease.frame",
          "params": {
            "lease_id": "lease",
            "seq": 1,
            "replay": true,
            "frame": "{\"jsonrpc\":\"2.0\",\"method\":\"event\",\"params\":{\"session_id\":\"runtime\",\"type\":\"subagent.complete\",\"payload\":{\"subagent_id\":\"child\",\"status\":\"completed\",\"goal\":\"Synthetic task\"}}}"
          }
        },
        {
          "jsonrpc": "2.0",
          "method": "relay.lease.frame",
          "params": {
            "lease_id": "lease",
            "seq": 2,
            "replay": true,
            "frame": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"accepted\":true}}"
          }
        },
        {
          "jsonrpc": "2.0",
          "method": "relay.lease.replay_complete",
          "params": {
            "lease_id": "lease",
            "last_seq": 2
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "accepted": true
          }
        }
      ],
      "expectedDelivered": 2,
      "expectedCursor": 2,
      "expectedReplayComplete": true,
      "expectedFailure": false
    },
